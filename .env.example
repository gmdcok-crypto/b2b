# 같은 Railway 프로젝트 안 MariaDB의 비공개 접속 URL.
# mysql:// 와 mariadb:// 는 애플리케이션이 mysql+pymysql:// 로 바꾼다.
# 값이 없어도 프로세스는 뜨고, GET /health 는 데이터베이스를 조회하지 않는다.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/scm
# MYSQL_URL=
# Netlify 사이트 주소. 여러 개면 쉼표로 구분한다.
# CORS_ORIGINS=https://gstec.netlify.app,https://b2bpart.netlify.app
APP_NAME=SCM B2B Portal

# JWT 액세스 토큰. 세 값이 모두 있을 때만 로그인을 요구한다.
# JWT_SECRET 은 32자 이상. 계정 테이블은 아직 없고, 이 값이 부트스트랩 계정이다.
# JWT_SECRET=
# AUTH_USERNAME=
# AUTH_PASSWORD=
# AUTH_DISPLAY_NAME=김구매
# JWT_EXPIRE_MINUTES=720
